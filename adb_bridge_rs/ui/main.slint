//
// ADB TCP 桥 —— 图形界面（Slint 声明式描述）
//
// 这里只描述「界面长什么样」以及「有哪些属性和回调」，
// 不含任何业务逻辑：数据由 Rust 侧写入属性，用户操作通过回调交回 Rust。
//
// ⚠️ 中文字体：Slint 内置字体不含中文，必须显式指定系统字体族，
// 否则界面汉字会渲染成方块（tofu）。

import {
    Button,
    LineEdit,
    CheckBox,
    ScrollView,
    ListView,
    Palette,
} from "std-widgets.slint";

// ---- 数据行定义（与 Rust 侧 struct 一一对应）----

export struct SessionRow {
    peer: string,
    elapsed: string,
    up: string,
    down: string,
    streams: int,
    active: bool,
}

export struct LogRow {
    time: string,
    level: string,
    category: string,
    text: string,
}

export struct DiagRow {
    name: string,
    ok: bool,
    detail: string,
}

// ---- 配色 ----
// 集中定义，改一处即可整体换肤
global Pal {
    in-out property <color> bg:        #14171d;
    in-out property <color> panel:     #1a1e26;
    in-out property <color> card:      #21262f;
    in-out property <color> card-hi:   #272d38;
    in-out property <color> border:    #2e3542;
    in-out property <color> text:      #e6e9ef;
    in-out property <color> text-dim:  #98a2b6;
    in-out property <color> accent:    #4c8dff;
    in-out property <color> ok:        #3ecf8e;
    in-out property <color> warn:      #f0b429;
    in-out property <color> danger:    #f0554d;
}

// 侧栏导航项
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 38px;
    border-radius: 7px;
    background: selected ? Pal.accent : transparent;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        x: 14px;
        text: root.label;
        color: root.selected ? white : Pal.text-dim;
        font-size: 14px;
        vertical-alignment: center;
        height: 100%;
    }
}

// 统计卡片
component StatCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> extra;

    height: 92px;
    border-radius: 10px;
    background: Pal.card;
    border-width: 1px;
    border-color: Pal.border;

    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        alignment: start;
        Text {
            text: root.label;
            color: Pal.text-dim;
            font-size: 12px;
        }
        Text {
            text: root.value;
            color: Pal.text;
            font-size: 19px;
            font-weight: 700;
            overflow: elide;
        }
        if root.extra != "": Text {
            text: root.extra;
            color: Pal.text-dim;
            font-size: 11px;
            overflow: elide;
        }
    }
}

// 分区标题
component SectionTitle inherits Text {
    font-size: 15px;
    font-weight: 600;
    color: Pal.text;
}

// ── 「关于软件」页的拓扑图组件 ──
//
// 为什么全部用几何图形拼、而不是 SVG：
// Slint 的 SVG 渲染走 usvg，其 Options::default() 里 fontdb 是**空的**
// （fontdb::Database::new()，没加载任何系统字体），所以 SVG 里的 <text>
// 一个字都渲染不出来。要显示中文只能回到 Slint 的 Text 叠字，反而更麻烦。
// 同样地，Rectangle 没有 rotation 属性（只有 ImageItem 有 rotation-angle），
// 所以箭头是几段递增横条堆出来的实心三角。

// 显示器图标：屏幕（描边矩形）+ 底座横条
component IconMonitor inherits Rectangle {
    in property <color> tint: Pal.text;
    background: transparent;
    width: 30px;
    height: 22px;
    VerticalLayout {
        spacing: 0;
        alignment: center;
        Rectangle {
            width: 26px;
            height: 15px;
            border-width: 2px;
            border-color: root.tint;
            border-radius: 2px;
            background: transparent;
        }
        Rectangle { width: 10px; height: 2px; background: root.tint; }
    }
}

// 芯片图标：上下各三根引脚 + 中间主体
component IconChip inherits Rectangle {
    in property <color> tint: Pal.text;
    background: transparent;
    width: 30px;
    height: 28px;
    VerticalLayout {
        spacing: 1px;
        alignment: center;
        HorizontalLayout {
            spacing: 5px;
            // horizontal-stretch: 0 —— HorizontalLayout 默认会把子元素横向拉伸，
            // 不显式关掉的话三根引脚会变成三条大色块
            Rectangle { horizontal-stretch: 0; width: 2px; height: 4px; background: root.tint; }
            Rectangle { horizontal-stretch: 0; width: 2px; height: 4px; background: root.tint; }
            Rectangle { horizontal-stretch: 0; width: 2px; height: 4px; background: root.tint; }
        }
        Rectangle {
            width: 22px;
            height: 17px;
            border-width: 2px;
            border-color: root.tint;
            border-radius: 2px;
            background: transparent;
        }
        HorizontalLayout {
            spacing: 5px;
            Rectangle { horizontal-stretch: 0; width: 2px; height: 4px; background: root.tint; }
            Rectangle { horizontal-stretch: 0; width: 2px; height: 4px; background: root.tint; }
            Rectangle { horizontal-stretch: 0; width: 2px; height: 4px; background: root.tint; }
        }
    }
}

// 拓扑节点：圆形 + 图标 + 标题 + 副标题
// icon-kind: 0 = 显示器（电脑），1 = 芯片（设备）
// highlight=true 用于强调中间那台跑桥的电脑 A
component TopoCircle inherits Rectangle {
    in property <int> icon-kind: 0;
    in property <string> node-title: "";
    in property <string> node-sub: "";
    in property <bool> highlight: false;

    width: 240px;
    height: 98px;
    background: transparent;
    border-width: 0;

VerticalLayout {
        spacing: 4px;
        alignment: center;
        // 圆形外面夹两段弹性，否则它会**左对齐**在组件左边缘
        // （Slint 的 layout 交叉轴：非拉伸子元素按 start 对齐）。
        // 标题 Text 是 fill 的，靠 horizontal-alignment: center 居中，
        // 所以圆和标题要各自用不同手段才对得上（实测偏差 82px）。
        HorizontalLayout {
            spacing: 0;
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                horizontal-stretch: 0;
                width: 56px;
                height: 56px;
                border-radius: 28px;
                background: root.highlight ? #1b2534 : Pal.card;
                border-width: 2px;
                border-color: root.highlight ? Pal.accent : Pal.border;
                // 图标在圆内居中 —— 同样用左右弹性夹住，
                // 理由和上面一致（VerticalLayout 管不了交叉轴）
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 0;
                        Rectangle { horizontal-stretch: 1; }
                        if root.icon-kind == 0: IconMonitor {
                            horizontal-stretch: 0;
                            tint: root.highlight ? Pal.accent : Pal.text;
                        }
                        if root.icon-kind == 1: IconChip {
                            horizontal-stretch: 0;
                            tint: root.highlight ? Pal.accent : Pal.text;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: root.node-title;
            color: Pal.text;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: root.node-sub;
            color: Pal.text-dim;
            font-size: 12px;
            horizontal-alignment: center;
        }
    }
}

// 连线：竖线 → 胶囊标签 → 继续竖线 → 实心三角箭头
//
// ⚠️ 两个 Slint 布局的坑都在这里踩过：
//  1. 标签不能作为竖线的兄弟元素放在右侧。试过 [弹性-线-弹性-胶囊]，
//     两段弹性等宽、胶囊又占掉一段，竖线偏离中轴约 47px。
//     现在标签自己占满整行、背景是不透明页面底色，正好把线"遮断"。
//  2. VerticalLayout/HorizontalLayout 的 alignment **只管主轴**，交叉轴上
//     非拉伸子元素一律**左对齐**。所以竖线、胶囊、三角每一行都得用
//     左右两段弹性夹一下才会落在中轴上（不夹的话竖线贴左边、标签偏 16px）。
component TopoLink inherits Rectangle {
    in property <string> link-label: "";

    width: 120px;
    height: 62px;
    background: transparent;
    border-width: 0;

    VerticalLayout {
        spacing: 0;
        alignment: center;

        HorizontalLayout {
            spacing: 0;
            Rectangle { horizontal-stretch: 1; }
            Rectangle { horizontal-stretch: 0; width: 1px; height: 14px; background: Pal.border; }
            Rectangle { horizontal-stretch: 1; }
        }

        HorizontalLayout {
            spacing: 0;
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                horizontal-stretch: 0;
                width: 88px;
                height: 19px;
                border-radius: 10px;
                background: Pal.bg;
                border-width: 1px;
                border-color: Pal.border;
                Text {
                    text: root.link-label;
                    color: Pal.text-dim;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        HorizontalLayout {
            spacing: 0;
            Rectangle { horizontal-stretch: 1; }
            Rectangle { horizontal-stretch: 0; width: 1px; height: 14px; background: Pal.border; }
            Rectangle { horizontal-stretch: 1; }
        }

        // 实心三角箭头：**宽边在上、尖端在下**（指向下一个节点）。
        // ⚠️ 顺序别搞反 —— 宽边在下方的话，尖端朝上，看起来就是箭头
        //    往回指（实测就是这个错）。
        HorizontalLayout {
            spacing: 0;
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                horizontal-stretch: 0;
                width: 10px;
                VerticalLayout {
                    spacing: 0;
                    alignment: center;
                    Rectangle { width: 10px; height: 2px; background: Pal.border; }
                    HorizontalLayout {
                        spacing: 0;
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle { horizontal-stretch: 0; width: 6px; height: 2px; background: Pal.border; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 0;
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle { horizontal-stretch: 0; width: 2px; height: 2px; background: Pal.border; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

// 日志列表。
//
// 包一层自定义组件，而不是直接用 ListView —— 因为 std-widgets 的ListView
// 是编译进二进制的内置组件，**不允许加 id**（实测报Unknown property id in
// ListView），所以没法从外部引用它、也就没法程序化滚动 viewport-y。
// 自己包一层后 id 就落在自定义组件上，可以正常用。
component LogList inherits Rectangle {
    in property <[LogRow]> rows;
    // 是否跟随新内容滚到底（界面上就是「自动滚动」那个勾选框）
    in-out property <bool> follow: true;
    // Rust 侧在日志**内容真的变了**时递增
    in property <int> tick: 0;

    background: Pal.card;
    border-radius: 8px;
    border-width: 1px;
    border-color: Pal.border;

    // 用 ListView，**不要**自己用 Flickable/ScrollView 拼。
    //
    // 为什么之前那套自绘滚动全错（根因，来自 Slint 源码）：
    //   internal/compiler/passes/flickable.rs 计算 viewport-height 时会
    //   `.filter(|x| x.borrow().repeated.is_none())` —— **跳过 for 循环产生
    //   的子元素**，且只统计类型是 layout 的直接子元素。我的 Flickable 里
    //   唯一的直接子元素是 TouchArea（不是 layout），于是
    //   viewport-height == height，max-scroll() 恒为 0，bottom-offset()
    //   恒为 0 —— 自动滚动每次都把列表拽回**顶部**，表现为「没生效」；
    //   而 Flickable 本身也不画滚动条。
    //
    // ListView 自带：
    //   - 滚动条（滚动条需要 maximum = viewport-height - visible-height，
    //     既然原版的滚动条一直是好的，说明 viewport-height 它算得对）
    //   - 滚轮（内部 TouchArea 的 scroll-event 调整 viewport-y）
    // 所以这里只管一件事：新日志到达时把 viewport-y 推到底。
    list := ListView {
        padding: 8px;
        for r in root.rows: HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text {
                text: r.time;
                width: 82px;
                color: Pal.text-dim;
                font-size: 11px;
                font-family: "Cascadia Mono";
            }
            Text {
                text: r.level;
                width: 46px;
                color: r.level == "ERROR" ? Pal.danger : (r.level == "WARN" ? Pal.warn : Pal.text-dim);
                font-size: 11px;
            }
            Text { text: r.text; color: Pal.text; font-size: 11px; wrap: word-wrap; }
        }
    }

    // 上次已经滚过的 tick。只在 tick 变化时才滚，避免每 0.1s 无条件把用户
    // 正在翻的历史日志强行拽回底部（之前就是这样「滚太快、日志被顶没」）。
    private property <int> handled-tick: 0;

    // 常驻重复 Timer。新日志到达（tick 变化）后滚到底一次。
    //
    // 为什么不用一次性 Timer + changed tick => restart()：restart() 只重置
    // 计时，不会把 running 从 false 拉起来，Timer 根本不触发。所以保持
    // running: true，用「tick 是否变化」当触发条件。
    //
    // viewport-y 的符号约定（来自 fluent/scrollview.slint 的 scrollbar）：
    // 向下滚 = 往**负**方向，0 是顶、-(viewport-height - visible-height) 是底。
    // 内容没溢出时（viewport-height <= visible-height）不滚，否则偏移为正、
    // 反而把第一行顶出视野。
    Timer {
        interval: 100ms;
        running: true;
        triggered => {
            if (root.tick != root.handled-tick) {
                root.handled-tick = root.tick;
                if (root.follow
                    && list.viewport-height > list.visible-height) {
                    list.viewport-y = -(list.viewport-height - list.visible-height);
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "ADB TCP 桥控制台";
    // ⚠️ 必须显式指定中文字体族，否则汉字全是方块
    default-font-family: "Microsoft YaHei";
    background: Pal.bg;
    // ⚠️ 默认尺寸要按「150% 缩放 + 2560x1600 屏」的实际观感定：逻辑像素
    //    会乘 1.5 变成物理像素，再加窗口边框。取 1320x800 -> 约 1980x1256
    //    物理像素，配合系统给的默认位置 (304,304)，底边落在 1560 以内，
    //    底部状态栏不会被屏幕边缘切掉。之前用 1440x900 时底边到了 1710，
    //    超出屏幕高度 1600，状态栏直接看不见。
    preferred-width: 1320px;
    preferred-height: 800px;
    min-width: 940px;
    min-height: 620px;

    // ⚠️ 必须显式声明深色模式，否则 std-widgets 控件的配色会跟我们的深色
    //    面板打架：CheckBox 的文字色取自 `FluentPalette.foreground`
    //    （见 Slint 源码 fluent/checkbox.slint），而它跟随全局 Palette 的
    //    color-scheme。Palette 默认走浅色方案，于是深色文字落在 #1a1e26
    //    的面板上，参数设置页那两个 CheckBox 几乎读不出来。
    //
    //    为什么不能像 Pal.bg 那样直接逐项设色：Palette 的 brush 属性
    //    （background/foreground/…）全部是 `out` 只读，唯一 in-out 的
    //    就是 color-scheme（它转发给 FluentPalette.color-scheme）。
    //    所以「切深色」是唯一正解，顺带把 LineEdit / Button / ListView /
    //    ScrollView 的配色也一起统一了。
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // ---- 状态（Rust 侧写入）----
    in property <int> page: 0;
    in property <bool> running: false;
    in property <string> status-label: "已停止";
    in property <string> listen-text: "-";
    in property <string> device-text: "未选择";
    in property <string> product-text: "-";
    in property <string> features-text: "-";
    in property <string> connect-cmd: "";
    in property <int> session-count: 0;
    in property <string> up-text: "0 B";
    in property <string> down-text: "0 B";
    in property <bool> port-danger: false;
    in property <string> suggested-port: "15555";
    in property <string> toast: "";
    in property <[SessionRow]> sessions: [];
    in property <[LogRow]> logs: [];
    in property <[DiagRow]> diag: [];

    // ---- 设置项（双向，界面可编辑）----
    in-out property <string> set-port: "15555";
    in-out property <string> set-addr: "0.0.0.0";
    in-out property <string> set-serial: "";
    in-out property <bool> set-no-kill: false;
    in-out property <bool> set-debug: false;
    in-out property <bool> auto-refresh: true;
    // 日志自动滚动：新日志到达时把列表拉到最底部。
    // 单独做成开关而不是恒定行为 —— 排障时经常要往上翻之前的日志，
    // 一有新日志就被拽回底部会很烦。
    in-out property <bool> auto-scroll: true;
    // 日志滚动触发器：Rust 侧每次刷新日志就+1，用来唤醒下面的 Timer。
    //
    // 为什么不让 .slint 自己监听日志变化：`changed` 只能监听**本组件声明的属性**
    // （写法是 `changed the-property => {...}`），写 `changed root.logs.length`
    // 解析不了。日志模型是从 Rust 绑进来的，只能由 Rust 显式通知。
    in property <int> log-tick: 0;

    // ---- 回调（Rust 侧实现）----
    callback pick-page(int);
    callback toggle-bridge();
    callback copy-command();
    callback clear-logs();
    callback run-diagnostics();
    callback save-settings();
    callback refresh-devices();

    HorizontalLayout {
        // ============ 左侧导航 ============
        Rectangle {
            width: 196px;
            background: Pal.panel;

            VerticalLayout {
                padding: 16px;
                spacing: 6px;
                alignment: start;

                Text {
                    text: "ADB TCP 桥";
                    color: Pal.text;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: "把 USB 设备共享到局域网";
                    color: Pal.text-dim;
                    font-size: 11px;
                }

                Rectangle { height: 12px; }

                NavItem { label: "控制台";      selected: root.page == 0; clicked => { root.pick-page(0); } }
                NavItem { label: "会话与流量";  selected: root.page == 1; clicked => { root.pick-page(1); } }
                NavItem { label: "运行日志";    selected: root.page == 2; clicked => { root.pick-page(2); } }
                NavItem { label: "参数设置";    selected: root.page == 3; clicked => { root.pick-page(3); } }
                NavItem { label: "诊断工具";    selected: root.page == 4; clicked => { root.pick-page(4); } }
                NavItem { label: "关于软件";    selected: root.page == 5; clicked => { root.pick-page(5); } }

                Rectangle { }   // 撑开，把下面推到底部

                Rectangle {
                    height: 1px;
                    background: Pal.border;
                }
                Text {
                    text: "Made with Slint";
                    color: Pal.text-dim;
                    font-size: 10px;
                }
            }
        }

        // ============ 右侧主区 ============
        VerticalLayout {
            // ---- 顶栏 ----
            Rectangle {
                height: 58px;
                background: Pal.panel;

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 12px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 5px;
                            y: (parent.height - self.height) / 2;
                            background: root.running ? Pal.ok : Pal.text-dim;
                        }
                        Text {
                            text: root.running ? "桥运行中" : "桥已停止";
                            color: Pal.text;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    Button {
                        text: root.running ? "停止桥" : "启动桥";
                        primary: true;
                        clicked => { root.toggle-bridge(); }
                    }
                }
            }

            // ---- 内容区（按页切换）----
            Rectangle {
                background: Pal.bg;

                // ===== 页 0：控制台 =====
                if root.page == 0: ScrollView {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 14px;
                        alignment: start;

                        GridLayout {
                            spacing: 12px;
                            StatCard { row: 0; col: 0; label: "监听地址"; value: root.listen-text; }
                            StatCard { row: 0; col: 1; label: "目标设备"; value: root.device-text; extra: "product: " + root.product-text; }
                            StatCard { row: 0; col: 2; label: "连接数";   value: root.session-count; }
                            StatCard { row: 0; col: 3; label: "流量";     value: "↑" + root.up-text + "  ↓" + root.down-text; }
                        }

                        SectionTitle { text: "电脑 B 连接方式"; }
                        Rectangle {
                            height: 46px;
                            border-radius: 8px;
                            background: Pal.card;
                            border-width: 1px;
                            border-color: Pal.border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 8px;
                                spacing: 10px;
                                alignment: space-between;
                                Text {
                                    text: root.connect-cmd;
                                    color: Pal.accent;
                                    font-size: 13px;
                                    font-family: "Cascadia Mono";
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: "复制";
                                    clicked => { root.copy-command(); }
                                }
                            }
                        }

                        if root.port-danger: Rectangle {
                            height: 44px;
                            border-radius: 8px;
                            background: Pal.danger.with-alpha(0.16);
                            border-width: 1px;
                            border-color: Pal.danger;
                            HorizontalLayout {
                                padding-left: 14px;
                                alignment: start;
                                Text {
                                    text: "当前端口落在 5555~5585，会产生幽灵设备 emulator-5554，建议改用 " + root.suggested-port;
                                    color: Pal.danger;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        SectionTitle { text: "设备信息"; }
                        Rectangle {
                            border-radius: 8px;
                            background: Pal.card;
                            border-width: 1px;
                            border-color: Pal.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                alignment: start;
                                Text { text: "serial: " + root.device-text;   color: Pal.text-dim; font-size: 12px; }
                                Text { text: "product: " + root.product-text; color: Pal.text-dim; font-size: 12px; }
                                Text { text: "features: " + root.features-text; color: Pal.text-dim; font-size: 12px; }
                            }
                        }

                        SectionTitle { text: "安全提醒"; }
                        Text {
                            text: "设备 C 的 adb shell 是 root，开放该端口等同于把完整 root shell 暴露给局域网。请只在可信网络中使用。";
                            color: Pal.warn;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                // ===== 页 1：会话与流量 =====
                if root.page == 1: VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    alignment: start;

                    SectionTitle { text: "会话与流量"; }

                    if root.sessions.length == 0: Text {
                        text: "当前没有客户端接入。在电脑 B 上执行 adb connect 后，这里会显示连接详情。";
                        color: Pal.text-dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    if root.sessions.length > 0: Rectangle {
                        border-radius: 8px;
                        background: Pal.card;
                        border-width: 1px;
                        border-color: Pal.border;
                        VerticalLayout {
                            padding: 6px;
                            // 表头
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 10px;
                                Text { text: "客户端 IP";  width: 150px; color: Pal.text-dim; font-size: 12px; }
                                Text { text: "时长";       width: 90px;  color: Pal.text-dim; font-size: 12px; }
                                Text { text: "上行";       width: 90px;  color: Pal.text-dim; font-size: 12px; }
                                Text { text: "下行";       width: 90px;  color: Pal.text-dim; font-size: 12px; }
                                Text { text: "stream";     width: 70px;  color: Pal.text-dim; font-size: 12px; }
                                Text { text: "状态";       color: Pal.text-dim; font-size: 12px; }
                            }
                            Rectangle { height: 1px; background: Pal.border; }
                            for s in root.sessions: HorizontalLayout {
                                padding: 8px;
                                spacing: 10px;
                                Text { text: s.peer;     width: 150px; color: Pal.text; font-size: 12px; overflow: elide; }
                                Text { text: s.elapsed;  width: 90px;  color: Pal.text-dim; font-size: 12px; }
                                Text { text: s.up;       width: 90px;  color: Pal.text; font-size: 12px; }
                                Text { text: s.down;     width: 90px;  color: Pal.text; font-size: 12px; }
                                Text { text: s.streams;  width: 70px;  color: Pal.text-dim; font-size: 12px; }
                                Text {
                                    text: s.active ? "进行中" : "已断开";
                                    color: s.active ? Pal.ok : Pal.text-dim;
                                    font-size: 12px;
                                }
                            }
                        }
                    }
                }

                // ===== 页 2：运行日志 =====
                if root.page == 2: VerticalLayout {
                    padding: 18px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 10px;
                        // 左标题、右控件。中间塞一个空 Rectangle 撑开：
                        // 不能把 CheckBox/Button 塞进嵌套 HorizontalLayout ——
                        // 嵌套布局默认吃掉全部宽度，会把复选框挤到「清空」按钮
                        // 底下（两者重叠），实测就是这个现象。
                        SectionTitle { text: "运行日志"; }
                        Rectangle { }
                        CheckBox {
                            text: "自动刷新";
                            checked: root.auto-refresh;
                            toggled => { root.auto-refresh = !root.auto-refresh; }
                        }
                        CheckBox {
                            text: "自动滚动";
                            checked: root.auto-scroll;
                            toggled => { root.auto-scroll = !root.auto-scroll; }
                        }
                        Button { text: "清空"; clicked => { root.clear-logs(); } }
                    }

                    log-list := LogList {
                        rows: root.logs;
                        follow: root.auto-scroll;
                        tick: root.log-tick;
                    }
                }

                // ===== 页 3：参数设置 =====
                if root.page == 3: ScrollView {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        alignment: start;

                        SectionTitle { text: "参数设置"; }
                        Text {
                            text: "保存后需重启桥生效。";
                            color: Pal.text-dim;
                            font-size: 12px;
                        }

                        GridLayout {
                            spacing: 10px;
                            Row {
                                Text { text: "监听端口"; color: Pal.text-dim; font-size: 13px; vertical-alignment: center; }
                                LineEdit { text: root.set-port; }
                            }
                            Row {
                                Text { text: "监听地址"; color: Pal.text-dim; font-size: 13px; vertical-alignment: center; }
                                LineEdit { text: root.set-addr; }
                            }
                            Row {
                                Text { text: "设备 serial"; color: Pal.text-dim; font-size: 13px; vertical-alignment: center; }
                                LineEdit { text: root.set-serial; placeholder-text: "留空则自动选择第一台在线设备"; }
                            }
                        }

                        CheckBox {
                            text: "端口被占用时不自动结束占用进程";
                            checked: root.set-no-kill;
                            toggled => { root.set-no-kill = !root.set-no-kill; }
                        }
                        CheckBox {
                            text: "打印协议包明细（排障用，量很大）";
                            checked: root.set-debug;
                            toggled => { root.set-debug = !root.set-debug; }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            // alignment: start 让按钮按内容宽度排布而不是拉满整行
                            alignment: start;
                            Button { text: "保存"; clicked => { root.save-settings(); } }
                            Button { text: "刷新设备列表"; clicked => { root.refresh-devices(); } }
                        }
                    }
                }

                // ===== 页 4：诊断工具 =====
                if root.page == 4: VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    alignment: start;

                    SectionTitle { text: "诊断工具"; }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Button { text: "运行自检"; clicked => { root.run-diagnostics(); } }
                    }

                    if root.diag.length > 0: Rectangle {
                        border-radius: 8px;
                        background: Pal.card;
                        border-width: 1px;
                        border-color: Pal.border;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            alignment: start;
                            for d in root.diag: HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    y: (parent.height - self.height) / 2;
                                    background: d.ok ? Pal.ok : Pal.danger;
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: start;
                                    Text { text: d.name; color: Pal.text; font-size: 13px; }
                                    Text { text: d.detail; color: Pal.text-dim; font-size: 11px; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }

                // ===== 页 5：关于软件 =====
                // 内容刻意保持一屏内：不做长段落说明，只留
                // 「是什么 → 数据怎么走 → 怎么用」三件事。
                if root.page == 5: ScrollView {
                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        alignment: start;

                        SectionTitle { text: "关于软件"; }

                        Text {
                            text: "让只接 USB 的设备，变成局域网里能用标准 adb 命令访问的网络设备。";
                            color: Pal.text-dim;
                            font-size: 13px;
                        }

                        // ---- 拓扑：电脑 B →（TCP）电脑 A →（USB）设备 C ----
                        HorizontalLayout { alignment: center;
                            TopoCircle { horizontal-stretch: 0; icon-kind: 0; node-title: "电脑 B"; node-sub: "用 adb 命令操作"; }
                        }
                        HorizontalLayout { alignment: center;
                            TopoLink { horizontal-stretch: 0; link-label: "TCP 局域网"; }
                        }
                        HorizontalLayout { alignment: center;
                            TopoCircle { horizontal-stretch: 0; icon-kind: 0; node-title: "电脑 A（本程序）"; node-sub: "设备通过 USB 接在这里"; highlight: true; }
                        }
                        HorizontalLayout { alignment: center;
                            TopoLink { horizontal-stretch: 0; link-label: "USB"; }
                        }
                        HorizontalLayout { alignment: center;
                            TopoCircle { horizontal-stretch: 0; icon-kind: 1; node-title: "设备 C"; node-sub: "无需改动、无需 root"; }
                        }

                        Rectangle {
                            height: 1px;
                            background: Pal.border;
                        }

                        // ---- 使用方法 ----
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Text { text: "1"; color: Pal.accent; font-size: 12px; font-weight: 700; width: 16px; }
                            Text { text: "在电脑 A 上启动本程序，点「启动桥」"; color: Pal.text-dim; font-size: 13px; }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Text { text: "2"; color: Pal.accent; font-size: 12px; font-weight: 700; width: 16px; }
                            Text {
                                text: "在电脑 B 上执行  adb connect 电脑A的IP:15555";
                                color: Pal.text-dim; font-size: 13px;
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Text { text: "3"; color: Pal.accent; font-size: 12px; font-weight: 700; width: 16px; }
                            Text {
                                text: "之后像普通设备一样用：adb -s 电脑A的IP:15555 shell";
                                color: Pal.text-dim; font-size: 13px;
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Text { text: "!"; color: Pal.warn; font-size: 12px; font-weight: 700; width: 16px; }
                            Text {
                                text: "端口用 15555，不要用 5555（会与模拟器冲突）";
                                color: Pal.text-dim; font-size: 13px;
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Pal.border;
                        }

                        Text {
                            text: "adb_bridge_rs v0.1.0 · GPL-3.0-only";
                            color: Pal.text-dim;
                            font-size: 11px;
                        }
                    }
                }
            }

            // ---- 底部状态栏 ----
            Rectangle {
                height: 34px;
                background: Pal.panel;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    alignment: start;

                    Text { text: root.status-label; color: root.running ? Pal.ok : Pal.text-dim; font-size: 12px; vertical-alignment: center; }
                    Rectangle { width: 1px; background: Pal.border; }
                    Text { text: "端口 " + root.listen-text; color: Pal.text-dim; font-size: 12px; vertical-alignment: center; }
                    Rectangle { width: 1px; background: Pal.border; }
                    Text { text: "设备 " + root.device-text; color: Pal.text-dim; font-size: 12px; vertical-alignment: center; }
                    Rectangle { width: 1px; background: Pal.border; }
                    Text { text: "会话 " + root.session-count; color: Pal.text-dim; font-size: 12px; vertical-alignment: center; }
                    Rectangle { width: 1px; background: Pal.border; }
                    Text { text: "↑" + root.up-text + " ↓" + root.down-text; color: Pal.text-dim; font-size: 12px; vertical-alignment: center; }
                    if root.toast != "": Text {
                        text: root.toast;
                        color: Pal.accent;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
